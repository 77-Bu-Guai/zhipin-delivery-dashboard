#!/usr/bin/env sh

# 团队化质量门禁（husky + lint-staged）
# 该文件随仓库提交（.husky/_ 由 prepare:husky 在 npm install 时自动重建），
# 任何人 clone 后 npm install 即自动生效，杜绝「换电脑漏拦」。

echo "🔍 [1/3] lint-staged：自动修复暂存文件（eslint --fix）..."
npx lint-staged || exit 1

echo "🔍 [2/3] 类型检查 tsc --noEmit ..."
npm run check || exit 1

echo "🔍 [3/3] Lint 门禁 eslint（error 级即拦截，warning 不拦截）..."
npm run lint || exit 1

echo "✅ 质量门禁通过，允许提交。"
